    {
      "id": "95e174c8-6856-43a7-b95b-7c707afe286a",
      "name": "Location Search",
      "description": {
        "content": "Search for locations by keyword query or geographic proximity. Returns up to 10 matching locations per request.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "d0990e7b-0908-4641-857a-3d98a1b19441",
          "name": "Search for Locations",
          "request": {
            "name": "Search for Locations",
            "description": {
              "content": "Returns up to 10 locations found by the given search query. You can use category, phone number, address, and latitude/longitude to search with more accuracy. Locations include hotels, restaurants, and attractions.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "location",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "searchQuery",
                  "value": "<string>",
                  "description": "(Required) The text query to search for matching locations."
                },
                {
                  "disabled": false,
                  "key": "category",
                  "value": "<string>",
                  "description": "Filter results by location category type."
                },
                {
                  "disabled": false,
                  "key": "phone",
                  "value": "<string>",
                  "description": "Phone number to search for a specific location."
                },
                {
                  "disabled": false,
                  "key": "address",
                  "value": "<string>",
                  "description": "Address string to improve search accuracy."
                },
                {
                  "disabled": false,
                  "key": "latLong",
                  "value": "<string>",
                  "description": "Latitude and longitude pair to bias search results toward a specific geographic area. Format is latitude,longitude."
                },
                {
                  "disabled": false,
                  "key": "radius",
                  "value": "<float>",
                  "description": "The radius distance from the latLong point to filter results."
                },
                {
                  "disabled": false,
                  "key": "radiusUnit",
                  "value": "km",
                  "description": "The unit of measurement for the radius parameter."
                },
                {
                  "disabled": false,
                  "key": "language",
                  "value": "en",
                  "description": "The language code for the response content. Tripadvisor supports 29 languages."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
