          "name": "Get Hotel Inventory",
          "request": {
            "name": "Get Hotel Inventory",
            "description": {
              "content": "Returns the partner's full list of hotel properties that are connected for availability checking. Tripadvisor queries this endpoint once per day and matches the returned hotels to Tripadvisor listings. Partners must provide their complete inventory and remove all test properties before the implementation is considered complete.",
              "type": "text/plain"
            },
